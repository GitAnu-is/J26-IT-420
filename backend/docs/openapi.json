{
  "openapi": "3.0.3",
  "info": {
    "title": "AgriGuard Backend REST API",
    "description": "AI-Powered Smart Agriculture Platform for Minimizing Post-Harvest Crop Losses.\nResearch Group: J26-IT-420, Sri Lanka Institute of Information Technology (SLIIT).\n\nSupported Crops:\n- BANANA (Musa acuminata)\n- PINEAPPLE (Ananas comosus)\n- BLACK_PEPPER (Piper nigrum)\n\nActive Research Components:\n- Component 1: AI-Based Crop Recommendation and Harvest Planning (Random Forest)\n- Component 2: AI-Based Plant Disease Detection and Severity Assessment (EfficientNet-B0, ResNet50, Grad-CAM)\n- Component 4: AI-Based Transportation Risk Prediction and Smart Packaging Recommendation (Gradient Boosting, XGBoost, CatBoost, Random Forest, SHAP)\n\nNote: Original Component 3 (Harvest Quality Grading) was removed with supervisor approval.",
    "version": "1.0.0",
    "contact": {
      "name": "Research Group J26-IT-420 - SLIIT",
      "url": "https://www.sliit.lk"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    },
    {
      "url": "http://10.0.2.2:5000",
      "description": "Android Emulator Loopback"
    }
  ],
  "tags": [
    { "name": "System Health & Discovery", "description": "Platform discovery, runtime status, and research provenance" },
    { "name": "Authentication & Session", "description": "User registration, JWT session lifecycle, password management" },
    { "name": "User Profile", "description": "Authenticated user profile management" },
    { "name": "Farm Management", "description": "Farm registration, field coordinates, and consolidated overview" },
    { "name": "Agricultural Records", "description": "Field agronomic, soil, and management observations" },
    { "name": "Component 1 - Crop & Harvest", "description": "AI-based crop recommendation and harvest duration prediction" },
    { "name": "Component 2 - Disease Detection", "description": "Plant disease classification, severity assessment, and Grad-CAM heatmaps" },
    { "name": "Component 4 - Transportation Risk", "description": "Transit damage risk prediction, SHAP attribution, and smart packaging" }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["System Health & Discovery"],
        "summary": "Root API discovery",
        "description": "Returns platform identity, research group, and supported crop list.",
        "responses": {
          "200": { "description": "Successful discovery payload" }
        }
      }
    },
    "/api/v1": {
      "get": {
        "tags": ["System Health & Discovery"],
        "summary": "API v1 discovery",
        "description": "Returns versioned route index and research components.",
        "responses": {
          "200": { "description": "API v1 metadata" }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": ["System Health & Discovery"],
        "summary": "Centralized system health",
        "description": "Returns runtime status, database connectivity, and non-blocking readiness of AI microservices.",
        "responses": {
          "200": { "description": "Health status object" }
        }
      }
    },
    "/api/v1/health/live": {
      "get": {
        "tags": ["System Health & Discovery"],
        "summary": "Liveness probe",
        "description": "Lightweight endpoint returning 200 if Node.js Express process is alive.",
        "responses": {
          "200": { "description": "Process is alive" }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": ["System Health & Discovery"],
        "summary": "Readiness probe",
        "description": "Returns 200 if backend database connection is ready to accept traffic; 503 if unready in production.",
        "responses": {
          "200": { "description": "Backend is ready" },
          "503": { "description": "Database unready" }
        }
      }
    },
    "/api/v1/provenance": {
      "get": {
        "tags": ["System Health & Discovery"],
        "summary": "Research models provenance",
        "description": "Exposes model identifiers, dataset provenance, validation statuses, and transparent research limitations.",
        "responses": {
          "200": { "description": "Provenance metadata" }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["Authentication & Session"],
        "summary": "User registration",
        "description": "Register a new user account with role FARMER, AGRICULTURAL_OFFICER, or TRANSPORT_OPERATOR. ADMIN cannot be self-registered.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fullName", "email", "password"],
                "properties": {
                  "fullName": { "type": "string", "example": "Nimal Perera" },
                  "email": { "type": "string", "format": "email", "example": "nimal@sliit.lk" },
                  "password": { "type": "string", "format": "password", "example": "Password123!" },
                  "phoneNumber": { "type": "string", "example": "0771234567" },
                  "role": { "type": "string", "enum": ["FARMER", "AGRICULTURAL_OFFICER", "TRANSPORT_OPERATOR"], "default": "FARMER" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully with access and refresh tokens" },
          "400": { "description": "Validation error or email already in use" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Authentication & Session"],
        "summary": "User login",
        "description": "Authenticate using email and password to receive JWT access token (15m) and refresh token (7d).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "nimal@sliit.lk" },
                  "password": { "type": "string", "format": "password", "example": "Password123!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authentication successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": ["Authentication & Session"],
        "summary": "Refresh session",
        "description": "Rotates refresh token and issues a new access token. Employs reuse detection to prevent replay attacks.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Tokens rotated successfully" },
          "401": { "description": "Invalid or revoked refresh token" }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["Authentication & Session"],
        "summary": "Logout active session",
        "description": "Revokes the provided refresh token session.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Logged out successfully" }
        }
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "tags": ["Authentication & Session"],
        "summary": "Logout from all devices",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "All refresh sessions revoked" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/auth/change-password": {
      "post": {
        "tags": ["Authentication & Session"],
        "summary": "Change password",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["currentPassword", "newPassword"],
                "properties": {
                  "currentPassword": { "type": "string" },
                  "newPassword": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password changed and other sessions revoked" },
          "400": { "description": "Validation error or invalid current password" }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": ["User Profile"],
        "summary": "Get authenticated user profile",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Profile retrieved" },
          "401": { "description": "Unauthorized" }
        }
      },
      "patch": {
        "tags": ["User Profile"],
        "summary": "Update user profile",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fullName": { "type": "string" },
                  "phoneNumber": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Profile updated" },
          "400": { "description": "Attempt to update restricted fields like role" }
        }
      }
    },
    "/api/v1/farms": {
      "post": {
        "tags": ["Farm Management"],
        "summary": "Register farm",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["farmName", "district"],
                "properties": {
                  "farmName": { "type": "string", "example": "Green Valley Farm" },
                  "district": { "type": "string", "example": "Kurunegala" },
                  "locationContext": { "type": "string", "example": "Pannala" },
                  "sizeHectares": { "type": "number", "example": 2.5 },
                  "soilType": { "type": "string", "example": "Red-Yellow Podzolic" },
                  "supportedCrops": { "type": "array", "items": { "type": "string", "enum": ["BANANA", "PINEAPPLE", "BLACK_PEPPER"] } },
                  "coordinates": {
                    "type": "object",
                    "properties": {
                      "latitude": { "type": "number", "example": 7.48 },
                      "longitude": { "type": "number", "example": 80.36 }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Farm registered successfully" }
        }
      },
      "get": {
        "tags": ["Farm Management"],
        "summary": "List farms",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "district", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of farms with pagination" }
        }
      }
    },
    "/api/v1/farms/{id}/overview": {
      "get": {
        "tags": ["Farm Management"],
        "summary": "Consolidated farm overview",
        "description": "Retrieves farm profile, agricultural records, and latest available C1, C2, C4 assessment results with component readiness states.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Consolidated farm workspace overview" },
          "403": { "description": "Forbidden - not owner or admin" },
          "404": { "description": "Farm not found" }
        }
      }
    },
    "/api/v1/crops/recommend": {
      "post": {
        "tags": ["Component 1 - Crop & Harvest"],
        "summary": "AI crop recommendation",
        "description": "Recommends Banana, Pineapple, or Black Pepper based on N-P-K soil nutrients, pH, moisture, and optional weather data.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nitrogen", "phosphorus", "potassium", "ph"],
                "properties": {
                  "farmId": { "type": "string" },
                  "nitrogen": { "type": "number", "example": 120 },
                  "phosphorus": { "type": "number", "example": 45 },
                  "potassium": { "type": "number", "example": 180 },
                  "ph": { "type": "number", "example": 6.2 },
                  "moisture": { "type": "number", "example": 72 },
                  "district": { "type": "string", "example": "Kurunegala" },
                  "latitude": { "type": "number", "example": 7.48 },
                  "longitude": { "type": "number", "example": 80.36 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Crop recommendation result with class probabilities" },
          "501": { "description": "Model unconfigured" },
          "503": { "description": "Inference microservice temporarily offline" }
        }
      }
    },
    "/api/v1/crops/predict-harvest": {
      "post": {
        "tags": ["Component 1 - Crop & Harvest"],
        "summary": "AI harvest duration prediction",
        "description": "Predicts remaining days to maturity and estimated harvest window.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["crop", "plantingDate"],
                "properties": {
                  "crop": { "type": "string", "enum": ["BANANA", "PINEAPPLE", "BLACK_PEPPER"] },
                  "plantingDate": { "type": "string", "format": "date", "example": "2026-01-15" },
                  "farmId": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Harvest prediction window and bounds" }
        }
      }
    },
    "/api/v1/crops/history": {
      "get": {
        "tags": ["Component 1 - Crop & Harvest"],
        "summary": "Prediction history",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Paginated history of crop recommendations and harvest plans" }
        }
      }
    },
    "/api/v1/diseases/analyze": {
      "post": {
        "tags": ["Component 2 - Disease Detection"],
        "summary": "Plant leaf image disease analysis",
        "description": "Accepts multipart/form-data plant photo or imageBase64 to classify diseases, assess severity (if validated), and generate Grad-CAM heatmaps.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["crop", "image"],
                "properties": {
                  "crop": { "type": "string", "enum": ["BANANA", "PINEAPPLE", "BLACK_PEPPER"] },
                  "image": { "type": "string", "format": "binary" },
                  "farmId": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Disease classification, severity status, management guidance, and artifact URLs" },
          "400": { "description": "Invalid image or crop" },
          "503": { "description": "Deep learning microservice offline" }
        }
      }
    },
    "/api/v1/diseases/assessments/{id}/gradcam": {
      "get": {
        "tags": ["Component 2 - Disease Detection"],
        "summary": "Retrieve Grad-CAM heatmap artifact",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "JPEG/PNG heatmap image binary stream" },
          "403": { "description": "Forbidden - not owner or admin" }
        }
      }
    },
    "/api/v1/diseases/assessments/{id}/image": {
      "get": {
        "tags": ["Component 2 - Disease Detection"],
        "summary": "Retrieve original uploaded leaf image",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Original image binary stream" },
          "403": { "description": "Forbidden - not owner or admin" }
        }
      }
    },
    "/api/v1/transportation/predict-risk": {
      "post": {
        "tags": ["Component 4 - Transportation Risk"],
        "summary": "Predict transit damage risk & smart packaging",
        "description": "Calculates damage probability, calibrated risk category (LOW, MEDIUM, HIGH), SHAP feature attribution, and recommended packaging guidelines.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["crop", "distanceKm", "durationHours", "vehicleType", "packagingType", "roadCondition"],
                "properties": {
                  "crop": { "type": "string", "enum": ["BANANA", "PINEAPPLE", "BLACK_PEPPER"] },
                  "distanceKm": { "type": "number", "example": 75 },
                  "durationHours": { "type": "number", "example": 3.0 },
                  "vehicleType": { "type": "string", "enum": ["OPEN_TRUCK", "COVERED_TRUCK", "REFRIGERATED_TRUCK", "THREE_WHEELER", "PICKUP", "TRACTOR_TRAILER"] },
                  "packagingType": { "type": "string", "enum": ["WOODEN_CRATES", "PLASTIC_CRATES", "CORRUGATED_BOXES", "GUNNY_BAGS", "JUTE_BAGS", "LOOSE_BULK", "POLYETHYLENE_LINED_BAGS"] },
                  "roadCondition": { "type": "string", "enum": ["PAVED_GOOD", "PAVED_POOR", "UNPAVED_ROUGH", "MIXED"] },
                  "temperatureCelsius": { "type": "number", "example": 28 },
                  "humidityPercentage": { "type": "number", "example": 80 },
                  "farmId": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Damage probability, riskLevel, SHAP explanations, and packaging recommendations" },
          "503": { "description": "Transport ML microservice offline" }
        }
      }
    },
    "/api/v1/transportation/recommend-packaging": {
      "post": {
        "tags": ["Component 4 - Transportation Risk"],
        "summary": "Independent smart packaging recommendations",
        "description": "Retrieves DOA and FAO grounded packaging, handling, and storage guidelines without invoking ML risk prediction models.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["crop", "distanceKm"],
                "properties": {
                  "crop": { "type": "string", "enum": ["BANANA", "PINEAPPLE", "BLACK_PEPPER"] },
                  "distanceKm": { "type": "number", "example": 110 },
                  "vehicleType": { "type": "string" },
                  "expectedDurationHours": { "type": "number" },
                  "currentPackagingType": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Packaging recommendations with supporting agronomic citations" }
        }
      }
    },
    "/api/v1/transportation/history": {
      "get": {
        "tags": ["Component 4 - Transportation Risk"],
        "summary": "Transportation assessment history",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Paginated history of transportation assessments" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Access Token (15 minute validity) obtained via /api/v1/auth/login or /api/v1/auth/register"
      }
    }
  }
}
