# ==============================================================================
# AgriGuard Unified Modular Monolith Environment Configuration Example
# Research Project: AI-Powered Smart Agriculture Platform (SLIIT J26-IT-420)
# Phase 9: Unified FastAPI Modular Monolith Backend (Port 8000)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FastAPI Server Runtime Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB Atlas or Local Instance)
# ------------------------------------------------------------------------------
# Atlas connection string format:
# mongodb+srv://<username>:<password>@cluster0.ishquho.mongodb.net/agriguard?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://agriguard_app:your_password@cluster0.ishquho.mongodb.net/agriguard?retryWrites=true&w=majority
DATABASE_NAME=agriguard

# ------------------------------------------------------------------------------
# 3. Security & Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (e.g., React frontend: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. JWT Authentication & Session Security
# ------------------------------------------------------------------------------
# Secrets must match across tokens for verification
JWT_ACCESS_SECRET=your_jwt_access_secret_key_at_least_32_characters_long_12345
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_at_least_32_characters_long_67890
JWT_ISSUER=agriguard
JWT_AUDIENCE=agriguard-clients
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 5. Model Artifact Directory Paths (In-Process ML Loading)
# ------------------------------------------------------------------------------
C1_ARTIFACTS_DIR=artifacts/c1
C2_ARTIFACTS_DIR=artifacts/c2
C4_ARTIFACTS_DIR=artifacts/c4
C2_STORAGE_PATH=uploads/diseases

# ------------------------------------------------------------------------------
# 6. Legacy Microservice Port Notice (Phase 9 Migration)
# ------------------------------------------------------------------------------
# In Phase 9, all research models (C1, C2, C4) are loaded in-process inside the
# unified FastAPI monolith on port 8000. Legacy ports 8001, 8002, 8003 and 5000
# are no longer required for active runtime operation.
